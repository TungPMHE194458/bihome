    "@mui/material": "^7.3.0",
    "@mui/x-charts": "^8.29.3",
    "@mui/x-date-pickers": "^8.11.0",
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.12.0",
    "dayjs": "^1.11.18",
    "notistack": "^3.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.63.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
