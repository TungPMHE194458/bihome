# Chép thành ~/bihome/.env trên server (chmod 600). Không commit file .env thật.
# Sinh secret: openssl rand -base64 48 | tr -d '/+=' | cut -c1-40

ORACLE_SYS_PASSWORD=
BIHOME_DB_PASSWORD=
BIHOME_JWT_SECRET=
# Header X-Webhook-Secret của POST /api/v1/webhooks/bank; để trống = từ chối mọi webhook.
BIHOME_BANK_WEBHOOK_SECRET=

BIHOME_CORS_ALLOWED_ORIGINS=https://bihome.bitrust.vn
BIHOME_WEB_PORT=18300

# Môi trường demo: nạp dữ liệu mẫu + ảnh demo. Production thật: bỏ seed-local và đặt BIHOME_DEMO_IMAGES=false.
BIHOME_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed-local
BIHOME_DEMO_IMAGES=true

BIHOME_PUSH_ENABLED=false
